{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/main.py"
    }
  ],
  "outputDirectory": ".",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
