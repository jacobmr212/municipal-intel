# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# 1. Copy this file to .env
# 2. Fill in your development API keys
# 3. Never commit .env to git (it's in .gitignore)
# =============================================================================

# Resend API Configuration (DEVELOPMENT)
# Create a TEST API key at: https://resend.com/api-keys
# Name it "municipal-intel-development"
RESEND_API_KEY=re_test_your_dev_key_here
RESEND_FROM_EMAIL=Municipal Intel <noreply@govtechdiagnostic.com>

# Application Configuration
# Local dev: http://localhost:8000
# Production: https://govtechdiagnostic.com (set in Railway)
APP_URL=http://localhost:8000

# JWT Secret (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=generate-a-random-secret-here

# Database
# Development: Can use production DB or create separate dev instance
DATABASE_URL=postgresql://user:pass@host/database?sslmode=require

# Optional: Anthropic API for AI analysis
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Admin email for notifications
ADMIN_EMAIL=your-email@example.com
